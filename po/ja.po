#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"システムリソースを節約するため、{mins}分間一時停止された後に終了しました。"

#: main.py:173 main.py:178
#, python-brace-format
msgid "{app_name} File Error"
msgstr "{app_name} ファイルエラー"

#: main.py:173
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "ファイルまたはフォルダが存在しません: {name}"

#: main.py:178
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "再生可能な音声ファイルが見つかりません: {name}"

#: main.py:196
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "再生が停止しました: ファイルまたはドライブにアクセスできません。"

#: main.py:214
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} はバックグラウンドで実行中です。ファイルマネージャーで音声ファイル"
"を開くと再生を開始できます。"

#: player.py:301 player.py:381 player.py:923
#, python-brace-format
msgid "{app_name} Error"
msgstr "{app_name} エラー"

#: player.py:302
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "FFmpeg または GStreamer で {name} のメタデータを読み込めませんでした。"

#: player.py:382
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:924
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"{name} の音声デコードに失敗しました。フォーマットを処理できませんでした。"

#: player.py:1005
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "pw-cat を起動できませんでした: {exc}"

#: player.py:1087
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"再生が停止しました: オーディオシステムまたはデコーダーでエラーが繰り返し発生"
"しました。"

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} はすでにバックグラウンドで起動しています。ファイルマネージャーで音"
"声ファイルを開いて再生してください。"

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - 停止"

#: tray.py:105
msgid "Playing"
msgstr "再生中"

#: tray.py:105
msgid "Paused"
msgstr "一時停止中"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "設定ファイルを開く"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "{app_name} を終了"
