msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "システムリソースを節約するため、{mins}分間一時停止された後に終了しました。"

msgid "{app_name} File Error"
msgstr "{app_name} ファイルエラー"

msgid "File or folder does not exist: {name}"
msgstr "ファイルまたはフォルダが存在しません: {name}"

msgid "Unable to find playable audio files for: {name}"
msgstr "再生可能な音声ファイルが見つかりません: {name}"

msgid "Playback stopped: files or drive are no longer accessible."
msgstr "再生が停止しました: ファイルまたはドライブにアクセスできません。"

msgid "{app_name} runs in the background! Open an audio file in your file manager to start music playback and control it using your desktop media widget."
msgstr "{app_name} はバックグラウンドで実行中です。ファイルマネージャーで音声ファイルを開くと再生を開始できます。"

msgid "{app_name} - Stopped"
msgstr "{app_name} - 停止"

msgid "Playing"
msgstr "再生中"

msgid "Paused"
msgstr "一時停止中"

msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

msgid "Open Config File"
msgstr "設定ファイルを開く"

msgid "Quit {app_name}"
msgstr "{app_name} を終了"

msgid "{app_name} Error"
msgstr "{app_name} エラー"

msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "FFmpeg または GStreamer で {name} のメタデータを読み込めませんでした。"

msgid "Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process format."
msgstr "{name} の音声デコードに失敗しました。フォーマットを処理できませんでした。"

msgid "Could not start pw-cat: {exc}"
msgstr "pw-cat を起動できませんでした: {exc}"

msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "再生が停止しました: オーディオシステムまたはデコーダーでエラーが繰り返し発生しました。"

msgid "{app_name} is already running in the background! Open an audio file in your file manager to start playback."
msgstr "{app_name} はすでにバックグラウンドで起動しています。ファイルマネージャーで音声ファイルを開いて再生してください。"
