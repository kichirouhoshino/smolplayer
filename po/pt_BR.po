#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"Fechado após ficar pausado por {mins} minutos para economizar recursos do "
"sistema."

#: main.py:173 main.py:178
#, python-brace-format
msgid "{app_name} File Error"
msgstr "Erro de arquivo do {app_name}"

#: main.py:173
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "O arquivo ou pasta não existe: {name}"

#: main.py:178
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr ""
"Não foi possível encontrar arquivos de áudio reproduzíveis para: {name}"

#: main.py:196
msgid "Playback stopped: files or drive are no longer accessible."
msgstr ""
"Reprodução interrompida: arquivos ou unidade não estão mais acessíveis."

#: main.py:214
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"O {app_name} roda em segundo plano! Abra um arquivo de áudio no seu "
"gerenciador de arquivos para iniciar a reprodução."

#: player.py:301 player.py:381 player.py:923
#, python-brace-format
msgid "{app_name} Error"
msgstr "Erro do {app_name}"

#: player.py:302
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Não foi possível ler os metadados de áudio de {name} com FFmpeg ou GStreamer."

#: player.py:382
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:924
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"Falha na decodificação de áudio de {name}. Nem FFmpeg nem GStreamer "
"conseguiram processar o formato."

#: player.py:1005
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Não foi possível iniciar pw-cat: {exc}"

#: player.py:1087
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Reprodução interrompida: o sistema de áudio ou o decodificador falhou "
"repetidamente."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"O {app_name} já está rodando em segundo plano! Abra um arquivo de áudio no "
"gerenciador de arquivos."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Parado"

#: tray.py:105
msgid "Playing"
msgstr "Reproduzindo"

#: tray.py:105
msgid "Paused"
msgstr "Pausado"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Abrir arquivo de configuração"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "Sair do {app_name}"
