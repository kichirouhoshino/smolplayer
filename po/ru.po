#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Закрыто после {mins} мин паузы для экономии системных ресурсов."

#: main.py:174 main.py:179
#, python-brace-format
msgid "{app_name} File Error"
msgstr "Ошибка файла {app_name}"

#: main.py:174
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Файл или папка не существует: {name}"

#: main.py:179
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Не удалось найти воспроизводимые аудиофайлы для: {name}"

#: main.py:197
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Воспроизведение остановлено: файлы или диск больше недоступны."

#: main.py:215
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} работает в фоновом режиме! Откройте аудиофайл в файловом "
"менеджере, чтобы начать воспроизведение."

#: player.py:331 player.py:421 player.py:1024
#, python-brace-format
msgid "{app_name} Error"
msgstr "Ошибка {app_name}"

#: player.py:332
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Не удалось прочитать метаданные аудио для {name} через FFmpeg или GStreamer."

#: player.py:422
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:1025
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"Сбой декодирования аудио для {name}. Ни FFmpeg, ни GStreamer не смогли "
"обработать формат."

#: player.py:1106
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Не удалось запустить pw-cat: {exc}"

#: player.py:1188
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Воспроизведение остановлено: аудиосистема или декодер неоднократно сбоили."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} уже работает в фоновом режиме! Откройте аудиофайл в файловом "
"менеджере для воспроизведения."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Остановлено"

#: tray.py:105
msgid "Playing"
msgstr "Воспроизведение"

#: tray.py:105
msgid "Paused"
msgstr "Пауза"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Открыть файл конфигурации"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "Выйти из {app_name}"
