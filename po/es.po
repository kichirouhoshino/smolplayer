msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Cerrado tras estar pausado durante {mins} minutos para ahorrar recursos del sistema."

msgid "{app_name} File Error"
msgstr "Error de archivo de {app_name}"

msgid "File or folder does not exist: {name}"
msgstr "El archivo o carpeta no existe: {name}"

msgid "Unable to find playable audio files for: {name}"
msgstr "No se pudieron encontrar archivos de audio reproducibles para: {name}"

msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Reproducción detenida: los archivos o la unidad ya no son accesibles."

msgid "{app_name} runs in the background! Open an audio file in your file manager to start music playback and control it using your desktop media widget."
msgstr "¡{app_name} se ejecuta en segundo plano! Abre un archivo de audio en tu administrador de archivos para comenzar la reproducción."

msgid "{app_name} - Stopped"
msgstr "{app_name} - Detenido"

msgid "Playing"
msgstr "Reproduciendo"

msgid "Paused"
msgstr "En pausa"

msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

msgid "Open Config File"
msgstr "Abrir archivo de configuración"

msgid "Quit {app_name}"
msgstr "Salir de {app_name}"

msgid "{app_name} Error"
msgstr "Error de {app_name}"

msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "No se pudieron leer los metadatos de audio para {name} con FFmpeg o GStreamer."

msgid "Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process format."
msgstr "Falló la decodificación de audio para {name}. Ni FFmpeg ni GStreamer pudieron procesar el formato."

msgid "Could not start pw-cat: {exc}"
msgstr "No se pudo iniciar pw-cat: {exc}"

msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "Reproducción detenida: el sistema de audio o el decodificador fallaron repetidamente."

msgid "{app_name} is already running in the background! Open an audio file in your file manager to start playback."
msgstr "¡{app_name} ya se está ejecutando en segundo plano! Abre un archivo de audio en tu administrador de archivos para reproducir."
