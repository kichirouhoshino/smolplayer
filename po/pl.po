#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"Zamknięto po wstrzymaniu na {mins} min, aby zaoszczędzić zasoby systemu."

#: main.py:163 main.py:168
#, python-brace-format
msgid "{app_name} File Error"
msgstr "Błąd pliku {app_name}"

#: main.py:163
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Plik lub folder nie istnieje: {name}"

#: main.py:168
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Nie znaleziono odtwarzalnych plików audio dla: {name}"

#: main.py:186
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Odtwarzanie zatrzymane: pliki lub dysk nie są już dostępne."

#: main.py:204
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} działa w tle! Otwórz plik audio w menedżerze plików, aby "
"rozpocząć odtwarzanie."

#: player.py:301 player.py:381 player.py:904
#, python-brace-format
msgid "{app_name} Error"
msgstr "Błąd {app_name}"

#: player.py:302
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Nie można odczytać metadanych audio dla {name} przy użyciu FFmpeg lub "
"GStreamer."

#: player.py:382
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:905
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr "Dekodowanie audio nie powiodło się dla {name}."

#: player.py:986
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Nie można uruchomić pw-cat: {exc}"

#: player.py:1068
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Odtwarzanie zatrzymane: system audio lub dekoder wielokrotnie zgłosił błąd."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr "{app_name} działa już w tle! Otwórz plik audio w menedżerze plików."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Zatrzymano"

#: tray.py:105
msgid "Playing"
msgstr "Odtwarzanie"

#: tray.py:105
msgid "Paused"
msgstr "Wstrzymano"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Otwórz plik konfiguracyjny"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "Zakończ {app_name}"
