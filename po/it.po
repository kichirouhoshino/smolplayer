msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Chiuso dopo essere stato in pausa per {mins} minuti per risparmiare risorse di sistema."

msgid "{app_name} File Error"
msgstr "Errore file {app_name}"

msgid "File or folder does not exist: {name}"
msgstr "Il file o la cartella non esiste: {name}"

msgid "Unable to find playable audio files for: {name}"
msgstr "Impossibile trovare file audio riproducibili per: {name}"

msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Riproduzione interrotta: i file o l'unità non sono più accessibili."

msgid "{app_name} runs in the background! Open an audio file in your file manager to start music playback and control it using your desktop media widget."
msgstr "{app_name} è in esecuzione in background! Apri un file audio nel gestore file per avviare la riproduzione."

msgid "{app_name} - Stopped"
msgstr "{app_name} - Interrotto"

msgid "Playing"
msgstr "In riproduzione"

msgid "Paused"
msgstr "In pausa"

msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

msgid "Open Config File"
msgstr "Apri file di configurazione"

msgid "Quit {app_name}"
msgstr "Esci da {app_name}"

msgid "{app_name} Error"
msgstr "Errore {app_name}"

msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "Impossibile leggere i metadati audio per {name} con FFmpeg o GStreamer."

msgid "Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process format."
msgstr "Decodifica audio fallita per {name}. Né FFmpeg né GStreamer sono riusciti a elaborare il formato."

msgid "Could not start pw-cat: {exc}"
msgstr "Impossibile avviare pw-cat: {exc}"

msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "Riproduzione interrotta: il sistema audio o il decodificatore hanno fallito ripetutamente."

msgid "{app_name} is already running in the background! Open an audio file in your file manager to start playback."
msgstr "{app_name} è già in esecuzione in background! Apri un file audio nel gestore file."
