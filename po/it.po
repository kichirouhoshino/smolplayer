#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"Chiuso dopo essere stato in pausa per {mins} minuti per risparmiare risorse "
"di sistema."

#: main.py:174 main.py:179
#, python-brace-format
msgid "{app_name} File Error"
msgstr "Errore file {app_name}"

#: main.py:174
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Il file o la cartella non esiste: {name}"

#: main.py:179
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Impossibile trovare file audio riproducibili per: {name}"

#: main.py:197
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Riproduzione interrotta: i file o l'unità non sono più accessibili."

#: main.py:215
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} è in esecuzione in background! Apri un file audio nel gestore "
"file per avviare la riproduzione."

#: player.py:331 player.py:421 player.py:1024
#, python-brace-format
msgid "{app_name} Error"
msgstr "Errore {app_name}"

#: player.py:332
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Impossibile leggere i metadati audio per {name} con FFmpeg o GStreamer."

#: player.py:422
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:1025
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"Decodifica audio fallita per {name}. Né FFmpeg né GStreamer sono riusciti a "
"elaborare il formato."

#: player.py:1106
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Impossibile avviare pw-cat: {exc}"

#: player.py:1188
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Riproduzione interrotta: il sistema audio o il decodificatore hanno fallito "
"ripetutamente."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} è già in esecuzione in background! Apri un file audio nel gestore "
"file."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Interrotto"

#: tray.py:105
msgid "Playing"
msgstr "In riproduzione"

#: tray.py:105
msgid "Paused"
msgstr "In pausa"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Apri file di configurazione"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "Esci da {app_name}"
