#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"Fermé après avoir été en pause pendant {mins} minutes pour économiser les "
"ressources système."

#: main.py:173 main.py:178
#, python-brace-format
msgid "{app_name} File Error"
msgstr "Erreur de fichier {app_name}"

#: main.py:173
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Le fichier ou dossier n'existe pas : {name}"

#: main.py:178
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Impossible de trouver des fichiers audio lisibles pour : {name}"

#: main.py:196
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Lecture arrêtée : les fichiers ou le lecteur ne sont plus accessibles."

#: main.py:214
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} s'exécute en arrière-plan ! Ouvrez un fichier audio dans votre "
"gestionnaire de fichiers pour lancer la lecture."

#: player.py:301 player.py:381 player.py:923
#, python-brace-format
msgid "{app_name} Error"
msgstr "Erreur {app_name}"

#: player.py:302
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Impossible de lire les métadonnées audio pour {name} avec FFmpeg ou "
"GStreamer."

#: player.py:382
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:924
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"Échec du décodage audio pour {name}. Ni FFmpeg ni GStreamer n'ont pu traiter "
"le format."

#: player.py:1005
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Impossible de démarrer pw-cat : {exc}"

#: player.py:1087
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Lecture arrêtée : le système audio ou le décodeur a échoué à plusieurs "
"reprises."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} est déjà en cours d'exécution en arrière-plan ! Ouvrez un fichier "
"audio dans votre gestionnaire de fichiers."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Arrêté"

#: tray.py:105
msgid "Playing"
msgstr "En cours de lecture"

#: tray.py:105
msgid "Paused"
msgstr "En pause"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Ouvrir le fichier de configuration"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "Quitter {app_name}"
