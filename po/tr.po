#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr ""
"Sistem kaynaklarından tasarruf etmek için {mins} dakika duraklatıldıktan "
"sonra kapatıldı."

#: main.py:174 main.py:179
#, python-brace-format
msgid "{app_name} File Error"
msgstr "{app_name} Dosya Hatası"

#: main.py:174
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Dosya veya klasör mevcut değil: {name}"

#: main.py:179
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Oynatılabilir ses dosyası bulunamadı: {name}"

#: main.py:197
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Oynatma durduruldu: dosyalara veya sürücüye artık erişilemiyor."

#: main.py:215
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} arka planda çalışıyor! Oynatmayı başlatmak için dosya "
"yöneticinizde bir ses dosyası açın."

#: player.py:331 player.py:421 player.py:1024
#, python-brace-format
msgid "{app_name} Error"
msgstr "{app_name} Hatası"

#: player.py:332
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "{name} için ses üst verileri okunamadı."

#: player.py:422
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:1025
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr "{name} için ses kod çözme başarısız oldu."

#: player.py:1106
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "pw-cat başlatılamadı: {exc}"

#: player.py:1188
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "Oynatma durduruldu: ses sistemi veya kod çözücü üst üste hata verdi."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} zaten arka planda çalışıyor! Oynatmayı başlatmak için bir ses "
"dosyası açın."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Durduruldu"

#: tray.py:105
msgid "Playing"
msgstr "Oynatılıyor"

#: tray.py:105
msgid "Paused"
msgstr "Duraklatıldı"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Yapılandırma Dosyasını Aç"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "{app_name} Uygulamasından Çık"
