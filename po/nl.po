#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Gesloten na {mins} minuten pauze om systeembronnen te besparen."

#: main.py:174 main.py:179
#, python-brace-format
msgid "{app_name} File Error"
msgstr "{app_name}-bestandfout"

#: main.py:174
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Bestand of map bestaat niet: {name}"

#: main.py:179
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Geen afspeelbare audiobestanden gevonden voor: {name}"

#: main.py:197
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Afspelen gestopt: bestanden of schijf niet langer toegankelijk."

#: main.py:215
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} draait op de achtergrond! Open een audiobestand in je "
"bestandsbeheer om het afspelen te starten."

#: player.py:331 player.py:421 player.py:1024
#, python-brace-format
msgid "{app_name} Error"
msgstr "{app_name}-fout"

#: player.py:332
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "Kan audiometadata voor {name} niet lezen."

#: player.py:422
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:1025
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr "Audiodecodering mislukt voor {name}."

#: player.py:1106
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "Kon pw-cat niet starten: {exc}"

#: player.py:1188
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "Afspelen gestopt: geluidssysteem of decoder bleef fouten geven."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} draait al op de achtergrond! Open een audiobestand in je "
"bestandsbeheer."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Gestopt"

#: tray.py:105
msgid "Playing"
msgstr "Afspeelt"

#: tray.py:105
msgid "Paused"
msgstr "Gepauzeerd"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Configuratiebestand openen"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "{app_name} sluiten"
