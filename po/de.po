msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Nach {mins} Minuten Pause geschlossen, um Systemressourcen zu sparen."

msgid "{app_name} File Error"
msgstr "{app_name}-Dateifehler"

msgid "File or folder does not exist: {name}"
msgstr "Datei oder Ordner existiert nicht: {name}"

msgid "Unable to find playable audio files for: {name}"
msgstr "Keine abspielbaren Audiodateien gefunden für: {name}"

msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Wiedergabe gestoppt: Dateien oder Laufwerk sind nicht mehr zugänglich."

msgid "{app_name} runs in the background! Open an audio file in your file manager to start music playback and control it using your desktop media widget."
msgstr "{app_name} läuft im Hintergrund! Öffnen Sie eine Audiodatei im Dateimanager, um die Musikwiedergabe zu starten."

msgid "{app_name} - Stopped"
msgstr "{app_name} - Gestoppt"

msgid "Playing"
msgstr "Wiedergabe"

msgid "Paused"
msgstr "Pausiert"

msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

msgid "Open Config File"
msgstr "Konfigurationsdatei öffnen"

msgid "Quit {app_name}"
msgstr "{app_name} beenden"

msgid "{app_name} Error"
msgstr "{app_name}-Fehler"

msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr "Audiodaten für {name} konnten weder mit FFmpeg noch mit GStreamer gelesen werden."

msgid "Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process format."
msgstr "Audiodekodierung für {name} fehlgeschlagen. Weder FFmpeg noch GStreamer konnten das Format verarbeiten."

msgid "Could not start pw-cat: {exc}"
msgstr "pw-cat konnte nicht gestartet werden: {exc}"

msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr "Wiedergabe gestoppt: Audiosystem oder Dekoder ist wiederholt fehlgeschlagen."

msgid "{app_name} is already running in the background! Open an audio file in your file manager to start playback."
msgstr "{app_name} läuft bereits im Hintergrund! Öffnen Sie eine Audiodatei im Dateimanager, um die Wiedergabe zu starten."
