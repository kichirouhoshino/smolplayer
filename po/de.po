#: main.py:48
#, python-brace-format
msgid "Closed after being paused for {mins} minutes to save system resources."
msgstr "Nach {mins} Minuten Pause geschlossen, um Systemressourcen zu sparen."

#: main.py:174 main.py:179
#, python-brace-format
msgid "{app_name} File Error"
msgstr "{app_name}-Dateifehler"

#: main.py:174
#, python-brace-format
msgid "File or folder does not exist: {name}"
msgstr "Datei oder Ordner existiert nicht: {name}"

#: main.py:179
#, python-brace-format
msgid "Unable to find playable audio files for: {name}"
msgstr "Keine abspielbaren Audiodateien gefunden für: {name}"

#: main.py:197
msgid "Playback stopped: files or drive are no longer accessible."
msgstr "Wiedergabe gestoppt: Dateien oder Laufwerk sind nicht mehr zugänglich."

#: main.py:215
#, python-brace-format
msgid ""
"{app_name} runs in the background! Open an audio file in your file manager "
"to start music playback and control it using your desktop media widget."
msgstr ""
"{app_name} läuft im Hintergrund! Öffnen Sie eine Audiodatei im Dateimanager, "
"um die Musikwiedergabe zu starten."

#: player.py:331 player.py:421 player.py:1024
#, python-brace-format
msgid "{app_name} Error"
msgstr "{app_name}-Fehler"

#: player.py:332
#, python-brace-format
msgid "Unable to read audio metadata for {name} with FFmpeg or GStreamer."
msgstr ""
"Audiodaten für {name} konnten weder mit FFmpeg noch mit GStreamer gelesen "
"werden."

#: player.py:422
#, python-brace-format
msgid ""
"Bit-perfect playback failed for {name}. Falling back to normal playback mode."
msgstr ""

#: player.py:1025
#, python-brace-format
msgid ""
"Audio decoding failed for {name}. Neither FFmpeg nor GStreamer could process "
"format."
msgstr ""
"Audiodekodierung für {name} fehlgeschlagen. Weder FFmpeg noch GStreamer "
"konnten das Format verarbeiten."

#: player.py:1106
#, python-brace-format
msgid "Could not start pw-cat: {exc}"
msgstr "pw-cat konnte nicht gestartet werden: {exc}"

#: player.py:1188
msgid "Playback stopped: audio system or decoder failed repeatedly."
msgstr ""
"Wiedergabe gestoppt: Audiosystem oder Dekoder ist wiederholt fehlgeschlagen."

#: mpris.py:394
#, python-brace-format
msgid ""
"{app_name} is already running in the background! Open an audio file in your "
"file manager to start playback."
msgstr ""
"{app_name} läuft bereits im Hintergrund! Öffnen Sie eine Audiodatei im "
"Dateimanager, um die Wiedergabe zu starten."

#: tray.py:104
#, python-brace-format
msgid "{app_name} - Stopped"
msgstr "{app_name} - Gestoppt"

#: tray.py:105
msgid "Playing"
msgstr "Wiedergabe"

#: tray.py:105
msgid "Paused"
msgstr "Pausiert"

#: tray.py:108
#, python-brace-format
msgid "{title}{artist} ({state})"
msgstr "{title}{artist} ({state})"

#: tray.py:191
msgid "Open Config File"
msgstr "Konfigurationsdatei öffnen"

#: tray.py:192
#, python-brace-format
msgid "Quit {app_name}"
msgstr "{app_name} beenden"
